# env / secrets (never commit)
.env

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# local tooling (mapshaper installed under tools/ via npm)
tools/
.tmp/

# data — raw snapshots are large; processed is generated by CI and
# deployed as a build artifact (never commit either to git history)
data/raw/*
!data/raw/sample/
!data/raw/sample/**
data/processed/*
!data/processed/.gitkeep

# os
.DS_Store
