{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Population growth v2: calendar years and explicit continuity",
  "type": "object",
  "required": [
    "schema_version",
    "processed_utc",
    "input_mode",
    "sql",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "processed_utc": {
      "type": "string",
      "format": "date-time"
    },
    "input_mode": {
      "enum": [
        "snapshot",
        "offline_example"
      ]
    },
    "sql": {
      "type": "string"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "region",
          "year",
          "pop",
          "previous_year",
          "cagr_start_year",
          "cagr_end_year",
          "yoy_growth_pct",
          "cagr5_pct",
          "pop_gain_5yr"
        ],
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "auckland",
              "waikato",
              "hawkes_bay",
              "canterbury",
              "otago",
              "southland"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": 1900
          },
          "pop": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "previous_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "cagr_start_year": {
            "type": "integer"
          },
          "cagr_end_year": {
            "type": "integer"
          },
          "yoy_growth_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "cagr5_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "pop_gain_5yr": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
