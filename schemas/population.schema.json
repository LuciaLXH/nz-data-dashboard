{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xli246/nz-data-dashboard/schemas/population.schema.json",
  "title": "Population processed dataset (W1)",
  "description": "Subnational population estimates (6 councils, 2018-2025) from the Stats NZ SDMX API (dataflow POPES_SUB_001), plus fetch status for Data Health.",
  "type": "object",
  "required": ["schema_version", "status", "processed_utc"],
  "properties": {
    "schema_version": {"const": 1},
    "processed_utc": {"type": "string", "format": "date-time"},
    "status": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": {"type": "boolean"},
        "note": {"type": "string"},
        "attempted_utc": {"type": "string", "format": "date-time"},
        "attempts": {"type": "integer", "minimum": 0},
        "last_status": {"type": ["integer", "null"]},
        "last_error": {"type": ["string", "null"]}
      }
    },
    "data": {
      "type": "object",
      "required": ["source", "dataflow", "fetched_utc", "regions"],
      "properties": {
        "source": {"type": "string"},
        "dataflow": {"type": "string"},
        "fetched_utc": {"type": "string", "format": "date-time"},
        "measures": {"type": "array", "items": {"type": "string"}},
        "areas": {"type": "object"},
        "regions": {
          "type": "object",
          "propertyNames": {"enum": ["auckland", "waikato", "hawkes_bay", "canterbury", "otago", "southland"]},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "POP": {"type": "number"},
                "MEDAGE": {"type": "number"},
                "NETMIG": {"type": "number"}
              }
            }
          }
        }
      }
    }
  }
}
