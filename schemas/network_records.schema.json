{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Normalized auditable NEPR network records v2",
  "type": "object",
  "required": [
    "schema_version",
    "processed_utc",
    "input_mode",
    "source_file",
    "source_sha256",
    "source_period",
    "period_start",
    "period_end",
    "period_days",
    "geography",
    "rows",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "processed_utc": {
      "type": "string",
      "format": "date-time"
    },
    "input_mode": {
      "enum": [
        "snapshot",
        "offline_example"
      ]
    },
    "source_file": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "source_period": {
      "type": "string"
    },
    "period_start": {
      "type": "string"
    },
    "period_end": {
      "type": "string"
    },
    "period_days": {
      "type": "integer",
      "minimum": 0
    },
    "geography": {
      "const": "operator_region_proxy"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "network_key",
          "account_id",
          "supply_id",
          "organization",
          "supply_name",
          "source_file",
          "region",
          "private_loss_boundary",
          "source_records",
          "population_served",
          "supply_m3_year",
          "loss_m3_year",
          "residential_connections",
          "nonresidential_connections",
          "nonresidential_use_m3_year",
          "carl_m3_year",
          "uarl_m3_year",
          "ili",
          "residential_median_l_connection_day",
          "issues",
          "raw_values",
          "quality_context"
        ],
        "properties": {
          "network_key": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "supply_id": {
            "type": "string"
          },
          "organization": {
            "type": "string"
          },
          "supply_name": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "enum": [
              "auckland",
              "waikato",
              "hawkes_bay",
              "canterbury",
              "otago",
              "southland"
            ]
          },
          "private_loss_boundary": {
            "enum": [
              "No",
              "Yes",
              "unknown"
            ]
          },
          "source_records": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 2
            }
          },
          "population_served": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "supply_m3_year": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "loss_m3_year": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "residential_connections": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "nonresidential_connections": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "nonresidential_use_m3_year": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "carl_m3_year": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "uarl_m3_year": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "ili": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "residential_median_l_connection_day": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "raw_values": {
            "type": "object",
            "required": [
              "population_served",
              "supply_m3_year",
              "loss_m3_year",
              "residential_connections",
              "nonresidential_connections",
              "nonresidential_use_m3_year",
              "carl_m3_year",
              "uarl_m3_year",
              "ili",
              "residential_median_l_connection_day"
            ],
            "additionalProperties": {
              "type": "string"
            }
          },
          "quality_context": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "audit": {
      "type": "object"
    }
  }
}
