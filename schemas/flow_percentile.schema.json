{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xli246/nz-data-dashboard/schemas/flow_percentile.schema.json",
  "title": "Source-water availability: same-week flow percentile (W2, sql/03)",
  "description": "Per monitored flow site: latest observed flow vs the same-week historical percentile (15-day window shifted across years, excluding the latest measurement). band: low (<25th), normal (25-75th), high (>75th), insufficient (<5 history days). stale_days flags sites whose last measurement is old (ORC public server ended 2021-04).",
  "type": "object",
  "required": ["schema_version", "sql", "processed_utc", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "sql": {"type": "string"},
    "processed_utc": {"type": "string", "format": "date-time"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["council", "site", "latest_date", "latest_flow_m3s", "units", "n_history", "pctile_pct", "band", "median_hist_m3s", "min_hist_m3s", "max_hist_m3s", "stale_days"],
        "properties": {
          "council": {"type": "string", "enum": ["hbrc", "orc"]},
          "site": {"type": "string"},
          "latest_date": {"type": "string", "format": "date"},
          "latest_flow_m3s": {"type": "number", "minimum": 0},
          "units": {"type": "string"},
          "n_history": {"type": "integer", "minimum": 0},
          "pctile_pct": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "band": {"type": "string", "enum": ["low", "normal", "high", "insufficient"]},
          "median_hist_m3s": {"type": ["number", "null"], "minimum": 0},
          "min_hist_m3s": {"type": ["number", "null"], "minimum": 0},
          "max_hist_m3s": {"type": ["number", "null"], "minimum": 0},
          "stale_days": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
