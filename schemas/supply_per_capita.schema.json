{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/xli246/nz-data-dashboard/schemas/supply_per_capita.schema.json",
  "title": "Demand-side supply pressure (W2, sql/02)",
  "description": "Per-region demand-side pressure: population x weighted per-capita supply (NEPR 2024/25), leakage, metering, implied daily demand and 5-year projection.",
  "type": "object",
  "required": ["schema_version", "sql", "processed_utc", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "sql": {"type": "string"},
    "processed_utc": {"type": "string", "format": "date-time"},
    "rows": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["region", "pop_2025", "coverage_pct", "l_per_person_day_w", "loss_pct_w", "ili_w", "daily_demand_m3", "leak_m3_day", "cagr5_pct", "proj_demand_m3_day"],
        "properties": {
          "region": {"type": "string", "enum": ["auckland", "waikato", "hawkes_bay", "canterbury", "otago", "southland"]},
          "pop_2025": {"type": "number", "minimum": 0},
          "coverage_pct": {"type": "number", "minimum": 0, "maximum": 100},
          "l_per_person_day_w": {"type": "number", "minimum": 0},
          "loss_pct_w": {"type": "number", "minimum": 0, "maximum": 100},
          "metering_pct_w": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "ili_w": {"type": "number", "minimum": 0},
          "daily_demand_m3": {"type": "number", "minimum": 0},
          "leak_m3_day": {"type": "number", "minimum": 0},
          "cagr5_pct": {"type": "number"},
          "proj_demand_m3_day": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
