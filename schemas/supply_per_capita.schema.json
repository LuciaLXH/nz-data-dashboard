                "reported_loss_networks": {
                  "type": "integer",
                  "minimum": 0
                },
                "reported_loss_m3_year": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "paired_networks": {
                  "type": "integer",
                  "minimum": 0
                },
                "paired_supply_m3_year": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "paired_loss_m3_year": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "paired_loss_pct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "paired_network_coverage_pct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "paired_supply_coverage_pct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "loss_above_supply_networks": {
